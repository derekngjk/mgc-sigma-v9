FRONTEND_ORIGIN=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres.[project-id]:[password]@[db-server].pooler.supabase.com:6543/postgres

# Synapxe HealthX Innovation Sandbox (HX-IS) — NGEMR FHIR R4 endpoint.
# Register at https://innovation.healthx.sg/ to obtain your sandbox URL and token.
# Use mock-oncology-123 as the patient ID to bypass the live endpoint during local dev.
FHIR_BASE_URL=https://sandbox.healthx.gov.sg/api/FHIR/R4/
FHIR_ACCESS_TOKEN=your-healthx-bearer-token

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Image generation provider. Valid values:
#   gemini (default) — Nano Banana (gemini-3.1-flash-image) primary, Imagen 4 fallback. Uses GEMINI_API_KEY.
#   openai           — gpt-image-2 at medium quality. Uses OPENAI_API_KEY.
IMAGE_PROVIDER=gemini
