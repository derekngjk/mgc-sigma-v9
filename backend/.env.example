FRONTEND_ORIGIN=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres.[project-id]:[password]@[db-server].pooler.supabase.com:6543/postgres

# Synapxe HealthX Innovation Sandbox (HX-IS) — FHIR R4B endpoint.
# The tenant ID is embedded in the URL path; get both the URL and API key from
# your HX-IS API Portal application (https://innovation.healthx.sg/).
# Auth is a per-tenant API key sent as the `x-api-key` header (NOT a bearer token).
# Use mock-oncology-123 as the patient ID to bypass the live endpoint during local dev.
FHIR_BASE_URL=https://api.healthx.sg/fhir/r4b/your-tenant-id
HEALTHX_API_KEY=your-healthx-api-key

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Image generation provider. Valid values:
#   gemini           — Nano Banana (gemini-3.1-flash-image) primary, Imagen 4 fallback. Uses GEMINI_API_KEY.
#   openai (default) — gpt-image-2 at medium quality. Uses OPENAI_API_KEY.
IMAGE_PROVIDER=openai

# Patient account auth. PATIENT_JWT_SECRET signs the patient session token;
# PATIENT_ID_PEPPER is the server-side pepper mixed into the name+NRIC login hash.
# Set both to long random strings in every real environment.
PATIENT_JWT_SECRET=dev-patient-jwt-secret-change-me
PATIENT_ID_PEPPER=dev-patient-id-pepper-change-me
