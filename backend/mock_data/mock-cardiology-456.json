            "reference": "Organization/TTSH",
            "display": "Tan Tock Seng Hospital"
          },
          "activity": [
            { "detail": { "description": "Daily weight measurement — alert care team if weight increases >2 kg in 2 days" } },
            { "detail": { "description": "Fluid restriction 1.5 L per day including all beverages" } },
            { "detail": { "description": "Cardiac rehabilitation programme — 3 sessions per week for 12 weeks" } },
            { "detail": { "description": "Follow-up echocardiogram in 3 months to reassess ejection fraction" } },
            { "detail": { "description": "HbA1c recheck in 6 weeks to evaluate glycaemic response to empagliflozin" } }
          ],
          "goal": [
            { "display": "Improve NYHA functional class from III to II" },
            { "display": "Prevent rehospitalisation for acute decompensation" },
            { "display": "Achieve HbA1c below 7.0% within 3 months" }
