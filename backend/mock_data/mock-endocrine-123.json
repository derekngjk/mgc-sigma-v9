    "entry": [
      {
        "resource": {
          "resourceType": "CarePlan",
          "subject": { "reference": "Patient/mock-endocrine-123", "display": "Nurul Aisyah binte Rahman" },
          "status": "active",
          "intent": "plan",
          "title": "Dual Endocrine Emergency Stabilisation Plan",
          "description": "Concurrent inpatient management of thyroid storm and diabetic ketoacidosis in the high-dependency unit, co-led by Endocrinology and Intensive Care, while treating the shared infective precipitant.",
          "author": {
            "reference": "Organization/SGH-ENDO",
            "display": "Singapore General Hospital — Department of Endocrinology"
          },
          "activity": [
            { "detail": { "status": "in-progress", "description": "DKA — fixed-rate IV insulin infusion at 0.1 units/kg/hr with hourly capillary glucose and blood ketone monitoring; continue long-acting basal insulin throughout." } },
            { "detail": { "status": "in-progress", "description": "DKA — IV 0.9% sodium chloride resuscitation with potassium replacement guided by 1–2 hourly potassium; add dextrose once glucose < 14 mmol/L; monitor for cerebral oedema." } },
            { "detail": { "status": "in-progress", "description": "Thyroid storm — propylthiouracil (PTU) 200 mg every 4 hours to block thyroid hormone synthesis and peripheral T4→T3 conversion." } },
            { "detail": { "status": "in-progress", "description": "Thyroid storm — Lugol's iodine given at least 1 hour AFTER PTU to inhibit hormone release (order matters to avoid the Jod-Basedow effect)." } },
            { "detail": { "status": "in-progress", "description": "Thyroid storm — IV propranolol (or esmolol) for adrenergic symptom control and rate control of atrial fibrillation." } },
            { "detail": { "status": "in-progress", "description": "Thyroid storm — IV hydrocortisone 100 mg every 8 hours for adrenal support and to further reduce T4→T3 conversion." } },
            { "detail": { "status": "in-progress", "description": "Precipitant — empirical antibiotics for the underlying urinary tract infection; paracetamol and active cooling for pyrexia (avoid aspirin, which displaces thyroid hormone from binding proteins)." } }
          ],
          "goal": [
            { "display": "Resolve ketoacidosis: close the anion gap, clear blood ketones to < 0.6 mmol/L, and transition to a subcutaneous basal-bolus insulin regimen." },
            { "display": "Control the thyrotoxic crisis: normalise heart rate and temperature and achieve a biochemically euthyroid state." },
            { "display": "Plan definitive Graves' disease therapy (radioactive iodine, long-term antithyroid drugs, or thyroidectomy) once the patient is stable." }
          ]
        }
      }
    ]
