      {
        "resource": {
          "resourceType": "CarePlan",
          "subject": { "reference": "Patient/mock-geriatric-202", "display": "Goh Swee Huat" },
          "status": "active",
          "intent": "plan",
          "title": "Geriatric Multi-Morbidity Management and Carer Support Plan",
          "description": "Coordinated management of Alzheimer's disease, atrial fibrillation, and osteoporosis with emphasis on fall prevention, anticoagulation safety, and carer education. Memory clinic and geriatrics co-managing.",
          "author": {
            "reference": "Organization/NUH",
            "display": "National University Hospital"
          },
          "activity": [
            { "detail": { "description": "Memory clinic review every 3 months — cognitive reassessment, medication review, and BPSD management" } },
            { "detail": { "description": "Fall risk assessment and home safety evaluation by occupational therapist — grab rails and stair gate recommended" } },
            { "detail": { "description": "Anticoagulation review — confirm adherence to apixaban, educate son on bleeding signs and missed dose protocol" } },
            { "detail": { "description": "DEXA scan repeat in 12 months to monitor alendronate response" } },
            { "detail": { "description": "Carer support referral — local dementia carers group and respite care assessment for family" } }
          ],
          "goal": [
            { "display": "Prevent falls and minimise fracture risk" },
            { "display": "Maintain anticoagulation for stroke prevention while monitoring bleeding risk" },
            { "display": "Support family/carers to manage behavioural symptoms and prevent carer burnout" },
            { "display": "Slow cognitive decline and maintain quality of life and dignity" }
          ]
        }
      }
    ]
