          "status": "active",
          "intent": "plan",
          "title": "MS Disease-Modifying Therapy and Symptom Management Plan",
          "description": "Continuation of natalizumab therapy with quarterly MRI surveillance and annual JC virus antibody index monitoring. Symptom management for fatigue and bladder dysfunction. Physiotherapy and occupational therapy support.",
          "author": {
            "reference": "Organization/NNI",
            "display": "National Neuroscience Institute"
          },
          "activity": [
            { "detail": { "description": "Natalizumab 300mg IV infusion every 4 weeks — next infusion in 3 weeks" } },
            { "detail": { "description": "Brain and spinal cord MRI with contrast every 6 months — surveillance for new lesions or PML" } },
            { "detail": { "description": "Annual JC virus antibody index — current index 2.1, discuss therapy switch if index rises further" } },
            { "detail": { "description": "Physiotherapy — core strengthening and balance exercises twice weekly" } },
            { "detail": { "description": "Neuropsychology assessment in 2 months to screen for cognitive changes" } }
          ],
          "goal": [
            { "display": "Prevent further relapses and new MRI lesion activity" },
            { "display": "Reduce fatigue impact to allow continued employment and daily activities" },
            { "display": "Minimise risk of progressive multifocal leukoencephalopathy (PML)" }
          ]
        }
      }
    ]
