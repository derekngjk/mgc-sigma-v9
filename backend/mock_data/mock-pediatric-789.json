            { "detail": { "description": "Monthly clinic visit — CBC, liver function, toxicity assessment" } },
            { "detail": { "description": "Prophylactic co-trimoxazole (Mon/Tue/Wed) — Pneumocystis prophylaxis" } },
            { "detail": { "description": "Interim maintenance lumbar puncture with intrathecal methotrexate at month 18" } }
          ],
          "goal": [
            { "display": "Maintain remission through completion of 24-month maintenance protocol" },
            { "display": "Monitor for and minimise chemotherapy toxicity (hepatotoxicity, myelosuppression)" },
